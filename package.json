{
  "name": "bps_waiting_game",
  "version": "1.0.0",
  "description": "Koleksi Game Santai Ruang Pelayanan Statistik Terpadu BPS",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "predeploy": "npm run build && npm run audit:all",
    "audit:size": "node scripts/audit/check-size.mjs",
    "audit:compat": "node scripts/audit/check-compat.mjs",
    "audit:viewport": "node scripts/audit/viewport-sim.mjs",
    "audit:fonts": "node scripts/audit/check-fonts.mjs",
    "audit:deps": "node scripts/audit/check-deps.mjs",
    "audit:external": "node scripts/audit/check-external.mjs",
    "audit:logic": "node --test tests/*.test.mjs",
    "audit:all": "npm run audit:viewport && npm run audit:size && npm run audit:compat && npm run audit:fonts && npm run audit:deps && npm run audit:external && npm run audit:logic"
  },
  "keywords": [
    "bps",
    "phaser",
    "games",
    "offline-ready"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "vite": "8.3.1"
  }
}